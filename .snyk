# Snyk (https://snyk.io) policy file
# These vulnerabilities are embedded in Docker CE binaries (docker-ce-cli, containerd.io)
# installed from the official Docker apt repository. They exist in Docker's internal
# Go standard library dependencies (x/crypto, x/net, opentelemetry) compiled into the
# Docker daemon/client binaries. The application does not expose SSH endpoints, HTTP/2
# servers, or OpenTelemetry exporters from within this image — the Docker socket is
# mounted from the host. Re-check when Docker releases packages compiled against
# x/crypto>=0.52.0 and x/net>=0.54.0.
version: v1.25.0
ignore:
